# Local environment example — placeholders only, never real secrets.
#
# Copy to `.env` (git-ignored) and fill in values:
#   Copy-Item .env.example .env
#
# Docker Compose reads the root `.env` for variable interpolation when run
# from the repository root. The Node.js services do NOT load this file
# automatically — export the service variables into each service process
# environment (or your shell profile) before starting services.

# --- Docker Compose (local infrastructure) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433
RABBITMQ_USER=oicunt
RABBITMQ_PASSWORD=change-me-local-only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Service database clients (single server, per-service database) ---
# Point all services at the local container; each service migrator creates
# and owns its own schema. DATABASE_NAME selects the service database.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me-local-only
# Model Registry default: oicunt_ai | Memory default: oicunt_memory
# Platform Usage: USAGE_DB_NAME=oicunt_usage (or set DATABASE_NAME per process)

# --- Service RabbitMQ clients ---
# amqp://<user>:<password>@127.0.0.1:5672
RABBITMQ_URL=amqp://oicunt:change-me-local-only@127.0.0.1:5672

# --- Internal service tokens (one strong random value per pair in real use) ---
# INTERNAL_SERVICE_TOKEN=change-me
# MODEL_REGISTRY_INTERNAL_TOKEN=
# MODEL_GATEWAY_INTERNAL_TOKEN=
# INFERENCE_INTERNAL_TOKEN=
# MEMORY_INTERNAL_TOKEN=
# AI_ORCHESTRATOR_INTERNAL_TOKEN=
# PLATFORM_USAGE_INTERNAL_TOKEN=

# --- Provider configuration (Model Gateway process only) ---
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Model Gateway durable metering outbox (P1; delivery lands in P2) ---
# Metering is explicitly opt-in: ENABLE_USAGE_PUBLISHING=true enables durable
# capture of provider usage events into PostgreSQL BEFORE success is
# reported. It is never implied by NODE_ENV: production requires the flag
# to be explicitly 'true' or 'false' and fails startup otherwise; any
# other value fails startup in every environment.
# The outbox lives in the shared cluster (DATABASE_HOST/PORT/USER/PASSWORD
# apply); OUTBOX_DB_* overrides select a separate endpoint when needed.
# OUTBOX_DB_NAME defaults to oicunt_ai. Schema changes run ONLY via:
#   pnpm --filter @oicunt-ai/service-model-gateway migrate
# (ordinary startup performs a read-only compatibility check, never DDL).
# ENABLE_USAGE_PUBLISHING=true
# OUTBOX_DB_HOST=
# OUTBOX_DB_PORT=
# OUTBOX_DB_NAME=oicunt_ai
# OUTBOX_DB_USER=
# OUTBOX_DB_PASSWORD=
# METERING_CAPTURE_TIMEOUT_MS=2000
# P2 delivery tuning (outbox drainer + hardened publisher; defaults in code):
# OUTBOX_DRAIN_BATCH_SIZE=50
# OUTBOX_DRAIN_CONCURRENCY=5
# OUTBOX_DRAIN_MAX_ATTEMPTS=20
# OUTBOX_DRAIN_BASE_DELAY_MS=1000
# OUTBOX_DRAIN_MAX_DELAY_MS=300000
# OUTBOX_DRAIN_LEASE_MS=300000
# OUTBOX_DRAIN_POLL_MS=1000
# METERING_PUBLISH_CONFIRM_TIMEOUT_MS=10000
# METERING_RECONNECT_INITIAL_MS=1000
# METERING_RECONNECT_MAX_MS=30000
